{
  "name": "lovemesomecoding_frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync-content": "./scripts/sync-content.sh",
    "dev": "node scripts/prebuild.mjs && next dev",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs && node scripts/verify-build.mjs",
    "preview": "node scripts/preview.mjs",
    "deploy": "npm run sync-content && npm run build && ./scripts/deploy.sh",
    "deploy:no-sync": "npm run build && ./scripts/deploy.sh",
    "cf-function": "node scripts/make-cf-function.mjs",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "next": "^14.2.5",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.3"
  }
}
